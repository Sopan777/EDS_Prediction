# Spectral Lab — Environment Variables
# Copy this file to .env and adjust values for your environment.
# The .env file is loaded automatically by python-dotenv at server startup.

# --- Server ---
# Port the Flask server listens on (default: 5000)
PORT=5000

# Flask environment: 'development' enables debug mode, 'production' disables it
FLASK_ENV=production

# --- Database ---
# SQLite path (relative to repo root, or absolute).
# Format: sqlite:///path/to/file.db  or leave empty for default (spectral_lab.db)
# DATABASE_URL=sqlite:///spectral_lab.db

# --- File Storage ---
# Directory where uploaded EDS reports are stored permanently.
# Default: <repo_root>/uploads/
# UPLOADS_DIR=./uploads

# --- Knowledge Base ---
# No configuration needed — materials.json and sigma_model.json are committed.
# Re-run training/derive_sigma_model.py and training/derive_knowledge.py only
# when data/EDS Consolidation.xlsx changes.
